zig-cache/
.zig-cache/
zig-out/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
/output
.pytest_cache/
/.venv/
# Generated by setup.py from the repository-root README (see _sync_readme)
/python/README.md
# Generated by setup.py from the repository-root include/ (see _sync_header)
/python/bolorgir/include/

# Development tool caches
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/

# Generated test coverage
.coverage
.coverage.*
htmlcov/
/coverage.xml

# Local test reports
/test-results/

# Benchmarks
benchmarks/results/

# Full coverage reports are committed gzip-compressed (coverage_*.json.gz);
# raw regenerated copies stay local (see benchmarks/coverage/README.md)
/benchmarks/coverage/coverage_*.json
/benchmarks/coverage/spec-v1/coverage_*.json

# Built core library inside the Python package (see _lib/README.md)
python/bolorgir/_lib/*.so*
python/bolorgir/_lib/*.dylib
python/bolorgir/_core.abi3.so

# Personal editor configuration and local development checks
/.vscode/extensions.json
/tests/local/
/tests/oracle/run_oracle_dbg_r1.py
/benchmarks/local/
/benchmarks/maskbench/PR_DRAFT.md
/LINKEDIN_POST.md
/tmp/

# Internal technical assignments (not published with the repository)
/TZ/

# Downloaded external corpus (pinned revision, see benchmarks/README.md)
benchmarks/external/

# Oracle harness: vendored JSON-Schema-Test-Suite snapshot and run reports
# (pinned commit recorded in tests/oracle/pin.json, see tests/oracle/README.md)
tests/oracle/external/
tests/oracle/results/

# Fuzzer artifacts (produced by runs, not versioned in git):
# auto corpus of schemas, campaign reports and JSON crash reproducers.
# Exception: archive of crashes found before the fixes (archive_pre_fix/).
tests/fuzz/corpus/auto/
tests/fuzz/artifacts/*
!tests/fuzz/artifacts/archive_pre_fix/
