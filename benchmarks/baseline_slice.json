{
  "version": 1,
  "created": "2026-09-20",
  "spec": "ROADMAP.md revision 2, section 6 (performance track) and review A8.5 (pinned perf slices)",
  "purpose": "Fixed baseline slice for the performance track. This list changes never; regressions are isolated against it. The phase slice and the full available set are measured separately and are NOT part of this file (A8.5). Baseline numbers: benchmarks/reports/20260920T022651_perf-baseline/REPORT.md.",
  "protocol": {
    "engine_mode": "adaptive",
    "profile": "canonical-v1",
    "memory_limit_mb": 256,
    "cache_limit_bytes": "default (64 MiB)",
    "parallelism": "1: strictly sequential observations, no other benchmark processes on the machine",
    "warmup": {
      "cold_permissive": "none: every observation is a fresh Engine + compile + new session, so the state is always a first visit",
      "warm_path": "one populating fill_mask per measured state, discarded; every timed observation is a verified cache hit (cache_hits delta == observation count)"
    },
    "observations": {
      "cold_permissive_fill_ns": 30,
      "warm_permissive_fill_ns": 10000,
      "corpus_warm_fill_ns": 10000
    },
    "aggregation": "benchmarks/bench_common.py percentile_stats: count/min/p50/p95/p99/max/mean",
    "timers": "time.perf_counter_ns around Session.fill_mask (wall); for the DFS cost model additionally the core-internal mask_ns_total and work_ops_total of blg_stats (C ABI) with work_limit_ops set so ops are counted"
  },
  "tokenizer_128k": {
    "name": "unsloth/Meta-Llama-3.1-8B-Instruct",
    "revision": "a2856192dd7c25b842431f39c179a6c2c2f627d1",
    "vocab_size": 128256,
    "family": "BPE with byte fallback (Llama 3.1)",
    "why": "the MaskBench default tokenizer and the 128k-token vocabulary of the ROADMAP section 6 baseline (cold permissive ~0.6 s, ~400k trie nodes)"
  },
  "tokenizer_synthetic": {
    "name": "synthetic byte vocabulary of bench_common.make_byte_tokenizer (256 single-byte tokens + common JSON pairs + EOS)",
    "why": "the tokenizer of the control-series warm-path benchmarks (B2/B3); corpus trace replay follows that convention"
  },
  "probes": [
    {
      "id": "permissive_string_content",
      "schema": {
        "type": "string"
      },
      "prefix_bytes": "\"",
      "why": "the state named in ROADMAP section 6: string content, (almost) every token byte-legal, the mask DFS walks the whole trie; this is the state with the <= 50 ms target"
    },
    {
      "id": "permissive_string_in_object",
      "schema": {
        "type": "object",
        "properties": {
          "s": {
            "type": "string"
          }
        },
        "required": [
          "s"
        ],
        "additionalProperties": false
      },
      "prefix_bytes": "{\"s\":\"",
      "why": "the same permissive state in the position where MaskBench instances actually reach it (string value of a closed object)"
    }
  ],
