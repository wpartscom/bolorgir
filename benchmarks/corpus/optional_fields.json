{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Необязательные поля с сохранением порядка объявления",
  "type": "object",
  "properties": {
    "id": {"type": "integer"},
    "nick": {"type": "string", "minLength": 1, "maxLength": 32},
    "email": {"type": "string", "maxLength": 254},
    "age": {"type": "integer"},
    "active": {"type": "boolean"},
    "note": {"type": "null"}
  },
  "required": ["id", "active"],
  "additionalProperties": false
}
