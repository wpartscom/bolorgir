{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unicode-строки: кириллица, CJK, emoji в enum и значениях",
  "type": "object",
  "properties": {
    "city": {"type": "string", "enum": ["Москва", "Санкт-Петербург", "北京", "東京", "Мюнхен"]},
    "greeting": {"type": "string", "minLength": 1, "maxLength": 40},
    "emoji": {"type": "string", "enum": ["🚀", "🎉", "❤️"]}
  },
  "required": ["city", "greeting"],
  "additionalProperties": false
}
